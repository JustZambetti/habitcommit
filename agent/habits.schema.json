{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JustZambetti/habitcommit/agent/habits.schema.json",
  "title": "HabitCommit habits.json",
  "description": "Plan configuration read by the HabitCommit Android app (schema 1). The app validates strictly: this schema is for editors and agents, the app remains the source of truth.",
  "type": "object",
  "required": ["schema", "timezone", "metrics", "plans"],
  "properties": {
    "schema": {
      "const": 1,
      "description": "Format version. Must be 1."
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "description": "IANA timezone, e.g. Europe/Rome. Defines what \"today\" means."
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "description": "What the user measures. Binary metrics are 0/1, ratings 0..max.",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "description": "Permanent identifier referenced by plans and journal events. Lowercase slug."
          },
          "label": {
            "type": "string",
            "description": "Display name. Defaults to the id when empty."
          },
          "type": {
            "enum": ["binary", "rating"],
            "default": "binary"
          },
          "max": {
            "type": "integer",
            "minimum": 2,
            "maximum": 10,
            "description": "Only allowed on rating metrics; defaults to 5."
          }
        },
        "additionalProperties": true,
        "if": {
          "properties": { "type": { "const": "binary" } },
          "required": ["type"]
        },
        "then": {
          "not": { "required": ["max"] }
        }
      }
    },
    "plans": {
      "type": "object",
      "minProperties": 1,
      "description": "Named sets of metrics. Object order matters: the first plan is the fallback.",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "Display name. Defaults to the plan id."
          },
          "items": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Metric ids. Duplicates are collapsed on read."
          }
        },
        "additionalProperties": true
      }
    },
    "schedule": {
      "type": "object",
      "properties": {
        "byWeekday": {
          "type": "object",
          "propertyNames": {
            "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]
          },
          "additionalProperties": { "type": "string" },
          "description": "Plan id for each weekday. Missing days fall back to the first plan."
        },
        "overrides": {
          "type": "object",
          "propertyNames": { "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "additionalProperties": {
            "type": "object",
            "if": { "required": ["plan"] },
            "then": {
              "properties": { "plan": { "type": "string" } }
            },
            "else": {
              "properties": {
                "add": { "type": "array", "items": { "type": "string" } },
                "remove": { "type": "array", "items": { "type": "string" } }
              }
            },
            "additionalProperties": true,
            "description": "Either swap the whole plan for that date or modify the scheduled plan. add/remove are ignored when plan is present."
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
